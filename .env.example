# ─── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host.railway.app:5432/pathwise?sslmode=require

# ─── Auth ──────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars

# ─── Server ────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ─── CORS ──────────────────────────────────────────────────────────────────
# Your GitHub Pages URL:
FRONTEND_URL=https://devlalit1.github.io

# ─── Frontend (Vite) ───────────────────────────────────────────────────────
# Set in .env.production (not committed) or Vite env vars:
VITE_API_URL=https://your-app.railway.app
